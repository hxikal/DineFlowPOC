APP_NAME=DineFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8002
APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=single
LOG_LEVEL=debug
# P1 preview needs no database. Never copy legacy credentials here.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dineflow_laravel_dev
DB_USERNAME=dineflow_dev
DB_PASSWORD=
DB_URL=
SESSION_DRIVER=file
SESSION_COOKIE=dineflow_laravel_session
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
MAIL_FROM_ADDRESS=demo@example.invalid
MAIL_FROM_NAME=DineFlow
VITE_APP_NAME=DineFlow
